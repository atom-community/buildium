{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "arrowParens": "always",
  "bracketSpacing": true,
  "embeddedLanguageFormatting": "auto",
  "htmlWhitespaceSensitivity": "css",
  "printWidth": 160,
  "proseWrap": "preserve",
  "quoteProps": "consistent",
  "semi": true,
  "singleQuote": true,
  "svelte": true,
  "tabWidth": 2,
  "trailingComma": "none",
  "useTabs": false,
  "ignorePatterns": ["lib", "styles/xterm.css", ".vscode"]
}
