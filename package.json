{
  "name": "buildium",
  "version": "0.76.1",
  "description": "Build your current project, directly from Pulsar",
  "keywords": [
    "build",
    "compile",
    "gulp",
    "make",
    "productivity"
  ],
  "license": "MIT",
  "repository": "https://github.com/idleberg/atom-buildium",
  "main": "./lib/buildium.js",
  "scripts": {
    "build": "tsdown",
    "dev": "npm run start",
    "format": "oxfmt",
    "lint:fmt": "oxfmt --check",
    "lint:js": "oxlint",
    "lint:svelte": "svelte-check --threshold warning",
    "lint:types": "tsc --noEmit",
    "lint": "npm-run-all --parallel lint:*",
    "start": "tsdown --watch",
    "test": "npm run lint",
    "prepublishOnly": "npm run build",
    "prepare": "husky install"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "cosmiconfig": "^10.0.0",
    "cross-spawn": "^7.0.3",
    "cson-parser": "^4.0.8",
    "nucleo-matcher-wasm": "^0.4.2",
    "tree-kill": "^1.0.0",
    "xregexp": "^5.0.1"
  },
  "devDependencies": {
    "@children-of-atom/dependency-manager": "^0.1.0",
    "@children-of-atom/svelte-view": "^0.1.1",
    "@pulsar-edit/types": "^1.132.0",
    "@types/cross-spawn": "^6.0.6",
    "@types/node": "^22.10.0",
    "confbox": "^0.2.4",
    "husky": "^7.0.0",
    "lint-staged": "^17.3.0",
    "npm-run-all2": "^9.0.3",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "rollup-plugin-svelte": "^7.2.3",
    "svelte": "^5.56.9",
    "svelte-check": "^4.7.5",
    "tsdown": "^0.22.14",
    "typescript": "^6.0.3"
  },
  "lint-staged": {
    "*.{js,ts,svelte}": [
      "oxlint --fix",
      "oxfmt"
    ],
    "*.{json,md}": "oxfmt"
  },
  "engines": {
    "atom": ">=1.0.0"
  },
  "activationCommands": {
    "atom-workspace": [
      "buildium:confirm",
      "buildium:error-match-first",
      "buildium:error-match",
      "buildium:no-confirm",
      "buildium:refresh-targets",
      "buildium:select-active-target",
      "buildium:stop",
      "buildium:toggle-panel",
      "buildium:trigger"
    ]
  },
  "activationHooks": [
    "core:loaded-shell-environment"
  ],
  "consumedServices": {
    "builder": {
      "versions": {
        "^2.0.0": "consumeBuilder"
      }
    },
    "status-bar": {
      "versions": {
        "^1.0.0": "consumeStatusBar"
      }
    },
    "busy-signal": {
      "versions": {
        "^1.0.0": "consumeBusySignal"
      }
    },
    "linter-indie": {
      "versions": {
        "1.0.0": "consumeLinterRegistry"
      }
    }
  },
  "dependencyManager": {
    "dependsOn": [
      "busy-signal"
    ],
    "conflictsWith": [
      {
        "name": "build"
      }
    ]
  }
}
